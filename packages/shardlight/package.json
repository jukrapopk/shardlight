{
  "name": "shardlight",
  "version": "0.2.1",
  "description": "Procedural lens-flare lights for React, three.js and React Three Fiber. Build a light once and it looks the same everywhere.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/**/*.js",
    "./src/**/*.ts",
    "./src/**/*.tsx"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js"
    },
    "./r3f": {
      "types": "./dist/r3f/index.d.ts",
      "import": "./dist/r3f/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8",
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.150"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@react-three/fiber": "^8.17.10",
    "@types/node": "^22.7.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  },
  "keywords": [
    "lens-flare",
    "procedural",
    "flare",
    "light",
    "glow",
    "shards",
    "three",
    "threejs",
    "react",
    "react-three-fiber",
    "r3f",
    "webgl",
    "canvas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Jukrapop K <jukrapopk@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jukrapopk/shardlight.git",
    "directory": "packages/shardlight"
  },
  "bugs": {
    "url": "https://github.com/jukrapopk/shardlight/issues"
  },
  "homepage": "https://jukrapopk.github.io/shardlight/"
}

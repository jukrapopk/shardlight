{
  "name": "shardlight-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.3.4",
  "description": "Monorepo for the shardlight package.",
  "homepage": "https://github.com/jukrapopk/shardlight#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jukrapopk/shardlight.git"
  },
  "bugs": {
    "url": "https://github.com/jukrapopk/shardlight/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter shardlight build",
    "test": "pnpm --filter shardlight test",
    "test:visual": "pnpm --filter shardlight test:visual",
    "typecheck": "pnpm --filter shardlight typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "demo": "pnpm build && pnpm --filter demo dev",
    "demo:build": "pnpm build && pnpm --filter demo build",
    "demo:preview": "pnpm --filter demo preview",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0"
  }
}
